{
  "name": "job-tracker-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "node --env-file=.env --import tsx src/node/server.ts",
    "test": "node --import tsx --test test/core.test.ts test/classify.test.ts test/discover.test.ts test/sources.test.ts test/agent.test.ts test/demo.test.ts test/alerts.test.ts test/salary.test.ts test/trigger.test.ts",
    "check-companies": "node --import tsx src/node/check-companies.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:demo": "wrangler deploy -c wrangler.demo.jsonc",
    "push-demo": "node --env-file=.env --import tsx src/node/push-demo.ts",
    "alerts": "node --env-file=.env --import tsx src/node/alerts.ts",
    "alerts:install": "node --env-file=.env --import tsx src/node/schedule.ts install",
    "alerts:uninstall": "node --env-file=.env --import tsx src/node/schedule.ts uninstall",
    "deploy:trigger": "wrangler deploy -c wrangler.trigger.jsonc"
  },
  "dependencies": {
    "agents": "0.33.0",
    "unpdf": "2.1.0",
    "nodemailer": "6.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.161.0",
    "@types/nodemailer": "6.4.24"
  }
}
