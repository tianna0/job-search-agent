# Copy this file to .env and fill in the values. .env is git-ignored.
# Workers AI (ranking by resume, and the optional local web app). Nothing needs deploying.

# Cloudflare dashboard -> Workers & Pages -> the "Account ID" shown in the right sidebar
CF_ACCOUNT_ID=

# Cloudflare dashboard -> My Profile -> API Tokens -> Create Token -> "Workers AI" template
CF_API_TOKEN=

# Optional: pushing your local scan into the public demo (npm run push-demo).
# DEMO_URL is the demo's address; DEMO_PUSH_TOKEN must match the secret you set with
#   npx wrangler secret put DEMO_PUSH_TOKEN -c wrangler.demo.jsonc
# Make it long and random, e.g. the output of: openssl rand -hex 24
DEMO_URL=
DEMO_PUSH_TOKEN=

# Job alerts (npm run alerts): emails you new matching jobs.
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  and paste it below (spaces are fine).
SMTP_USER=
SMTP_PASS=
# Where to send alerts (defaults to SMTP_USER)
MAIL_TO=
# Other providers: change these (465 = SSL, 587 = STARTTLS)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Optional: only jobs whose location mentions one of these (comma-separated, case-insensitive)
# ALERT_LOCATIONS=United States, USA, US
# Only jobs posted in the last N days (default 1 = today or yesterday; repeats are never sent).
# Jobs from sites without a posting date are sent the day they first show up. 0 = no age filter.
# ALERT_MAX_AGE_DAYS=1
# Ranking new jobs against your resume (uses Workers AI: CF_ACCOUNT_ID / CF_API_TOKEN above).
# Resume: a .pdf or .txt file; if unset, the resume you uploaded in the local app is used.
# RESUME_FILE=~/Documents/resume.pdf
# How many top jobs get a one-line reason from Llama 3.3 (default 8; 0 = scores only)
# ALERT_TOP_N=8
# ALERT_RANKING=off   to skip ranking entirely
# Hour for the daily run set up by npm run alerts:install (0-23, default 19 = 7 pm)
# ALERT_HOUR=19
